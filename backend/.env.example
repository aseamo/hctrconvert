# ─────────────────────────────────────────
# HctrConvert — Environment Configuration
# ─────────────────────────────────────────
# Copy this to .env and customize as needed.
# All values below show the defaults.

# App
APP_NAME=HctrConvert
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8001
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5500"]

# File limits
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=tmp/uploads
OUTPUT_DIR=tmp/outputs

# External tools (leave blank to auto-detect)
FFMPEG_PATH=ffmpeg
LIBREOFFICE_PATH=

# Logging
LOG_LEVEL=INFO
